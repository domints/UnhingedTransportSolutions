# Copy to .env (next to this file) and fill in.
# Plain `docker compose up -d` picks up ./env automatically (project directory
# = this directory). Pass --env-file only if yours lives elsewhere:
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d

POSTGRES_PASSWORD=change-me

# Port the app listens on (host side). Bound to 127.0.0.1 — TLS is your
# reverse proxy's job. Unset the mapping in favour of a docker network if
# your proxy is a container.
UTS_PORT=8080

# Prebuilt image from GHCR (built by the GitHub Action) — set this to skip
# building on the server, e.g. ghcr.io/yourname/yourrepo:latest
# UTS_IMAGE=

# --- Authentik OIDC ---
# Base URL of your Authentik, e.g. https://authentik.example.com
OIDC_AUTHORITY=
# Provider client id / secret from Authentik admin panel
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
# Claim that carries user groups (Authentik default: groups)
OIDC_GROUPS_CLAIM=groups

# Only members of this Authentik group may use the admin panel
AUTH_ADMIN_GROUP=uts-admins

# Set true when running behind a reverse proxy that sets X-Forwarded-* headers
AUTH_BEHIND_PROXY=false

# DEV ONLY — enables POST /api/dev/login fake admin login. Never enable publicly.
AUTH_DEV_AUTH=false

# --- Telegram bot (leave empty to keep the module off) ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Public base URL of this site for tracking buttons in bot messages,
# e.g. https://parcel.example.com
TELEGRAM_SITE_PUBLIC_URL=
# Comma-separated chat IDs that receive app-admin alerts (bruteforce, PIN
# regen, …). Also the legacy fallback for courier bot commands until every
# courier finishes onboarding in the panel.
TELEGRAM_ADMIN_CHAT_IDS=
