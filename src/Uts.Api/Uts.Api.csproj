<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Uts.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Apphost generation crashes on a flaky native runtime on this machine;
         `dotnet Uts.Api.dll` and Docker both run without it. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Npgsql" Version="9.*" />
    <PackageReference Include="Telegram.Bot" Version="22.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>

  <!-- dotnet.exe-run bin/ output: bring wwwroot along so ContentRoot (bin) can serve the SPA -->
  <Target Name="CopyWwwrootToOutput" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/wwwroot')">
    <ItemGroup>
      <WwwRootFiles Include="$(MSBuildProjectDirectory)/wwwroot/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WwwRootFiles)" DestinationFiles="@(WwwRootFiles->'$(OutputPath)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
