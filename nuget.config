<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Offline nuget.org fallback: TLS to nuget.org fails on this machine's dotnet,
         so verified packages were downloaded into ./packages-local via curl. -->
    <add key="local" value="packages-local" />
  </packageSources>
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>
</configuration>
